+    let named = match v {
+        Value::Table(t) => Some(gc_arena::Gc::as_ptr(t.into_inner()) as *const ()),
+        Value::UserData(u) => Some(gc_arena::Gc::as_ptr(u.into_inner()) as *const ()),
+        _ => None,
