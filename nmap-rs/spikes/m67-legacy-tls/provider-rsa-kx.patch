+    /// RSAES-PKCS1-v1_5 (RFC 8017 §7.2.1): `00 02 PS 00 M`, PS at least 8
+    /// nonzero random bytes. `None` when `m` does not fit or randomness fails.
+    pub(crate) fn encrypt_pkcs1(
+        &self,
+        m: &[u8],
+        mut fill: impl FnMut(&mut [u8]) -> bool,
+    ) -> Option<Vec<u8>> {
+        let ps_len = self.k.checked_sub(m.len().checked_add(3)?)?;
+        if ps_len < 8 {
+            return None;
+        }
+        let mut ps = vec![0u8; ps_len];
+        if !fill(&mut ps) {
+            return None;
+        }
+        for b in &mut ps {
+            while *b == 0 {
+                let mut one = [0u8; 1];
+                if !fill(&mut one) {
+                    return None;
+                }
+                *b = one[0];
+            }
+        }
+        let mut em = vec![0x00, 0x02];
+        em.extend_from_slice(&ps);
+        em.push(0x00);
+        em.extend_from_slice(m);
+        let c = BigUint::from_bytes_be(&em).modpow(&self.e, &self.n).to_bytes_be();
+        let mut out = vec![0u8; self.k.checked_sub(c.len())?];
+        out.extend_from_slice(&c);
+        Some(out)
+    }
