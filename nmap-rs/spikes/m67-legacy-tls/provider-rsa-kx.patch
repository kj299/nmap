+/// RSA key transport: RSAES-PKCS1-v1_5 to the leaf's key, read by the reader
+/// the verifier uses.
+#[derive(Debug)]
+pub(crate) struct RsaTransport;
+
+impl rustls::crypto::RsaKeyTransport for RsaTransport {
+    fn encrypt_premaster(
+        &self,
+        end_entity: &rustls::pki_types::CertificateDer<'_>,
+        premaster: &[u8],
+    ) -> Result<Vec<u8>, Error> {
+        let cert = nmap_core::nse::openssl::x509::d2i_x509_len(end_entity.as_ref())
+            .ok_or(Error::General("leaf does not decode".into()))?
+            .0;
+        let Ok(super::sigs::PeerKey::Rsa(n, e)) = super::sigs::PeerKey::from_cert(&cert) else {
+            return Err(Error::General("RSA key exchange needs an RSA key".into()));
+        };
+        let key = super::rsa::RsaPublicKey::new(&n, &e)
+            .ok_or(Error::General("RSA key is degenerate".into()))?;
+        key.encrypt_pkcs1(premaster, |buf| rustls::crypto::SecureRandom::fill(&rand::OsRandom, buf).is_ok())
+            .ok_or(Error::General("RSA key too small for the premaster".into()))
     }
 }
